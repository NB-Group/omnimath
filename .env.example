# Omnimath backend (optional for local development)
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are public: the anon key is designed to be shipped in the browser.
# Never put a service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (public site key). Enable the Edge Function for this to work.
VITE_TURNSTILE_SITE_KEY=

# GitHub project pages only. Leave unset for a custom domain or <user>.github.io.
# BASE_PATH=/omnimath/
